# systemd unit for a Tacita node / seed node
# Install: sudo cp tacitad.service /etc/systemd/system/ && sudo systemctl enable --now tacitad
[Unit]
Description=Tacita full node (tacitad)
After=network-online.target
Wants=network-online.target

[Service]
User=tacita
Group=tacita
Type=simple
ExecStart=/opt/tacita/tacitad --config-file /etc/tacita/tacita.conf --non-interactive
Restart=always
RestartSec=10
TimeoutStopSec=120
LimitNOFILE=65536
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/tacita

[Install]
WantedBy=multi-user.target
