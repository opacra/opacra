# systemd unit for a Opacra node / seed node
# Install: sudo cp opacrad.service /etc/systemd/system/ && sudo systemctl enable --now opacrad
[Unit]
Description=Opacra full node (opacrad)
After=network-online.target
Wants=network-online.target

[Service]
User=opacra
Group=opacra
Type=simple
ExecStart=/opt/opacra/opacrad --config-file /etc/opacra/opacra.conf --non-interactive
Restart=always
RestartSec=10
TimeoutStopSec=120
LimitNOFILE=65536
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/opacra

[Install]
WantedBy=multi-user.target
